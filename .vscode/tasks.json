{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AquaSense: verificar ambiente",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/verificar_ambiente_macos.sh"
      ],
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          "scripts\\verificar_ambiente_windows.cmd"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AquaSense: compilar macOS",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/compilar_macos.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "AquaSense: compilar Windows MSVC",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "build.bat"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "AquaSense: testar conexao (AGUA_* configuradas)",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/testar_conexao.sh"
      ],
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          "scripts\\testar_conexao_windows.cmd"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AquaSense: testes C locais",
      "type": "process",
      "command": "python3",
      "args": [
        "tests/run_tests.py"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "tests\\run_tests.py"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AquaSense: executar cliente real",
      "type": "process",
      "command": "${workspaceFolder}/build/aquasense",
      "windows": {
        "command": "${workspaceFolder}\\build\\monitoramento.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AquaSense: iniciar SQL Server local (macOS)",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/servidor_local.py",
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AquaSense: verificar conexao local (macOS)",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/servidor_local.py",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AquaSense: executar com SQL Server local (macOS)",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/servidor_local.py",
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AquaSense: parar SQL Server local (macOS)",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/servidor_local.py",
        "stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
